# Rust, with its standard library, built for RV32 in an ordinary Docker stage and
# shipped in a shem image. Rust has no RV32 Linux target without floating point,
# which shem's guests are, so riscv32imac-shem-linux-musl.json describes one (the
# compressed instructions of the C extension, on both vCPUs, are why a Rust
# target can be this small), the standard library is built for it from source with
# a pinned nightly, and the guest toolchain (`just toolchain` builds shem-toolchain)
# links it against musl.
FROM shem-toolchain AS build
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN case "$TARGETARCH" in \
        amd64) arch=x86_64; sha=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
        arm64) arch=aarch64; sha=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/1.28.2/$arch-unknown-linux-gnu/rustup-init" \
 && printf '%s  /tmp/rustup-init\n' "$sha" > /tmp/rustup-init.sha256 \
 && sha256sum -c /tmp/rustup-init.sha256 \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --profile minimal --default-toolchain nightly-2026-02-22 -c rust-src \
 && rm /tmp/rustup-init
ENV PATH=/root/.cargo/bin:$PATH
COPY link.sh /usr/local/bin/rv32-link
WORKDIR /src
COPY Cargo.toml riscv32imac-shem-linux-musl.json ./
COPY .cargo .cargo
COPY src src
RUN cargo build --release -Zjson-target-spec -Zbuild-std=std,panic_abort \
        --target /src/riscv32imac-shem-linux-musl.json

FROM scratch
COPY --from=build /src/target/riscv32imac-shem-linux-musl/release/hello /bin/hello
LABEL org.opencontainers.image.licenses="MIT"
ENTRYPOINT ["/bin/hello"]
CMD ["from", "rust"]
