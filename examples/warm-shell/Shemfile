# A BusyBox shell, started at build time and frozen just before it first reads
# its script from stdin. Running the image skips the shell's startup and goes
# straight to reading. `just busybox-image` builds shem-busybox.
FROM shem-busybox AS busybox

FROM scratch
COPY --from=busybox / /
ENV PATH=/bin:/sbin:/usr/bin:/usr/sbin
# BusyBox is GPL-2.0, built from its source by toolchain/Dockerfile
LABEL org.opencontainers.image.licenses="GPL-2.0-only" org.opencontainers.image.source="https://busybox.net/downloads/busybox-1.38.0.tar.bz2"
ENTRYPOINT ["/bin/sh"]
WARM --until=syscall:read
